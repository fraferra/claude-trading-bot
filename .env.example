# Anthropic (Claude) API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Alpaca Trading API (paper trading)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key

# Polymarket (optional — only needed for live trading)
POLYMARKET_PRIVATE_KEY=your-ethereum-private-key
POLYMARKET_API_KEY=your-polymarket-api-key
POLYMARKET_API_SECRET=your-polymarket-api-secret
POLYMARKET_API_PASSPHRASE=your-polymarket-passphrase

# Kalshi prediction market API
KALSHI_API_KEY_ID=your-kalshi-key-id
KALSHI_PRIVATE_KEY=your-rsa-private-key-pem-contents

# Dashboard auth (required for Docker deployment)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-strong-password
